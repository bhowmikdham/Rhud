// Rhud core schema.
// Sprint 1 scope: tenants, users, magic_links + RLS foundation.
// Later sprints add: templates, engagements, thread_events, tokens, files, ml_models.
//
// Tenant isolation contract:
//   - Every tenant-scoped table has RLS enabled + a policy keyed on
//     current_setting('app.tenant_id')::uuid.
//   - App code connects as the `rhud_app` role (NOBYPASSRLS) and must call
//     withTenant() before any DB access. See apps/api/src/db/with-tenant.ts.
//   - Migrations run as the superuser (DATABASE_URL); runtime uses APP_DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  plan        String   @default("mvp")
  // JSONB configs for external integrations; secrets live in KMS/Doppler,
  // these columns hold non-secret pointers (urls, workspace ids, etc.).
  odooConfig         Json?    @map("odoo_config")
  slackConfig        Json?    @map("slack_config")
  teamsConfig        Json?    @map("teams_config")
  gammaConfig        Json?    @map("gamma_config")
  // Per-tenant notification routing override. See @rhud/shared
  // TenantNotificationConfig. Null = use defaults.
  notificationConfig Json?    @map("notification_config")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  users           User[]
  magicLinks      MagicLink[]
  templates       Template[]
  engagements     Engagement[]
  auditChainLinks AuditChainLink[]
  rateCards       RateCard[]
  predictions     Prediction[]
  pricingConfig   TenantPricingConfig?
  invites         Invite[]
  llmConfig       TenantLlmConfig?
  gammaConfigRow  TenantGammaConfig?
  userIntegrations UserIntegration[]
  outlookApp      TenantOutlookApp?

  @@map("tenants")
}

/// Per-tenant Microsoft Entra app credentials. One row per workspace
/// (set up once by an admin via the UI). The app must be registered
/// as multi-tenant + personal accounts so any user signing in can
/// authorize it. The redirect URI is server-side derived (it's the
/// same for all tenants — points at our /integrations/outlook/callback)
/// so we don't store it; just display it in the setup modal.
///
/// The client secret is envelope-encrypted with the same DEK pattern
/// as TenantLlmConfig.
model TenantOutlookApp {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// The Application (client) ID from Entra — public, displayed back
  /// in the admin UI for sanity-check.
  clientId String @map("client_id")

  /// Encrypted client secret. Per-row DEK wrapped by the master key
  /// (LLM_KEY_ENCRYPTION_KEY).
  clientSecretCiphertext    Bytes @map("client_secret_ciphertext")
  clientSecretIv            Bytes @map("client_secret_iv")
  clientSecretDekCiphertext Bytes @map("client_secret_dek_ciphertext")
  clientSecretDekIv         Bytes @map("client_secret_dek_iv")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_outlook_app")
}

model Template {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  serviceLine String   @map("service_line")
  name        String
  version     Int      @default(1)
  // draft | published | archived — CHECK constraint in migration SQL.
  status      String   @default("draft")
  // FK to the first node in the tree. Nullable: new templates start empty.
  rootNodeId  String?  @map("root_node_id") @db.Uuid
  // Default rate card used for engagements issued from this template.
  // Null on legacy templates; quotes are computed iff the engagement's
  // template has one set at submission time.
  rateCardId  String?  @map("rate_card_id") @db.Uuid
  /// Optional Gamma template id. When proposal drafting routes through
  /// Gamma, this id is forwarded so the deck inherits the template's
  /// layout / theme. Null = let Gamma pick a default.
  gammaTemplateId String? @map("gamma_template_id")
  /// Optional proposal scaffold — Markdown with {{token}} merge fields.
  /// When set, proposal generation renders this scaffold (substituting
  /// data tokens like {{client_name}}, {{price}}, {{scope_summary}})
  /// instead of asking the LLM to compose from scratch. Gives the
  /// consultancy full control over boilerplate (values, terms,
  /// signature) while only the dynamic parts vary per opportunity.
  proposalScaffold String? @map("proposal_scaffold")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rateCard    RateCard?      @relation(fields: [rateCardId], references: [id], onDelete: SetNull)
  nodes       TemplateNode[]
  engagements Engagement[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([rateCardId])
  @@map("templates")
}

// ── Sprint 3: engagements, gathering, threads, files ────────────────────────

model Engagement {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  templateId          String   @map("template_id") @db.Uuid
  // Snapshot of the template version this engagement was issued against, so
  // editing the template later doesn't change in-flight engagements.
  templateVersion     Int      @default(1) @map("template_version")
  salesEmployeeId     String   @map("sales_employee_id") @db.Uuid
  salesManagerId      String?  @map("sales_manager_id") @db.Uuid
  clientEmail         String   @map("client_email") @db.Citext
  // Free-text label shown in the UI ("Acme Q3 Security Assessment"). The
  // table itself is still called engagements for historical reasons; the
  // user-facing concept is "Opportunity".
  name                String?
  // Lifecycle — see @rhud/shared ENGAGEMENT_STATUSES. CHECK in migration.
  status              String   @default("issued")
  predictedPriceCents BigInt?  @map("predicted_price_cents")
  priceLowCents       BigInt?  @map("price_low_cents")
  priceHighCents      BigInt?  @map("price_high_cents")
  approvedPriceCents  BigInt?  @map("approved_price_cents")
  // Snapshot of closed-engagement count for this tenant at predict-time.
  // Pinned so a re-evaluation later doesn't shift regime under our feet.
  closedEngagementCountSnapshot Int? @map("closed_engagement_count_snapshot")
  odooQuotationId     String?  @map("odoo_quotation_id")
  // Loop cursor state, keyed by loop node id:
  //   { "<loopNodeId>": { iter: <currentIteration>, status: 'iterating'|'done' } }
  // The runtime updates this as the responder enters/exits each loop;
  // findCurrentNode reads it to know which body iteration to show.
  loopState           Json     @default("{}") @map("loop_state")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  submittedAt         DateTime? @map("submitted_at") @db.Timestamptz
  closedAt            DateTime? @map("closed_at") @db.Timestamptz

  /// Current AI-generated proposal draft. Single column (one draft at a
  /// time) — regenerate replaces. Persists from `drafting` through `sent`
  /// so the rep can copy it into their email client at any point.
  proposalDraft       String?   @map("proposal_draft")
  proposalDraftedAt   DateTime? @map("proposal_drafted_at") @db.Timestamptz
  /// Provider that produced the current draft, e.g. 'anthropic',
  /// 'manual', 'gamma'. Surfaced in the UI so reps know what to
  /// expect (inline text vs link to a Gamma deck).
  proposalDraftSource String?   @map("proposal_draft_source")
  /// When the draft was produced by Gamma — the deck's URL + id.
  /// For LLM drafts these stay null and the text lives in proposalDraft.
  gammaDeckUrl        String?   @map("gamma_deck_url")
  gammaDeckId         String?   @map("gamma_deck_id")
  /// Gamma's generation job id — set while a Gamma deck is being
  /// drafted, cleared once the deck is ready (or failed). Used by
  /// getCurrent() to poll Gamma's status endpoint without re-running
  /// the create call.
  gammaGenerationId        String?   @map("gamma_generation_id")
  gammaGenerationStartedAt DateTime? @map("gamma_generation_started_at") @db.Timestamptz

  /// PDF export of the current proposal — surfaced as the attachment in
  /// the Send-to-client modal. Populated for Gamma drafts via the
  /// `exportAs: 'pdf'` flag at generation time. Gamma export URLs
  /// expire after ~7 days (per the public docs); we cache the
  /// approximate expiry so the UI can prompt the rep to regenerate
  /// instead of handing them a dead link.
  proposalPdfUrl       String?   @map("proposal_pdf_url")
  proposalPdfExpiresAt DateTime? @map("proposal_pdf_expires_at") @db.Timestamptz

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template    Template          @relation(fields: [templateId], references: [id])
  tokens      GatheringToken[]
  answers     EngagementAnswer[]
  files       EngagementFile[]
  events      ThreadEvent[]
  quote       EngagementQuote?
  predictions Prediction[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([salesEmployeeId])
  @@map("engagements")
}

// Persisted output of the deterministic Stage 2 base price computation,
// plus space for Stage 3 modifier predictions and manager overrides.
// One per engagement; recomputed on submit.
model EngagementQuote {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  engagementId             String    @unique @map("engagement_id") @db.Uuid
  rateCardId               String?   @map("rate_card_id") @db.Uuid
  rateCardVersion          Int       @map("rate_card_version")
  currency                 String
  baseTotalCents           BigInt    @map("base_total_cents")
  baseBreakdown            Json      @map("base_breakdown")
  // Stage 3 (modifier) — nullable until ML lands.
  predictedAdjustmentPct   Decimal?  @map("predicted_adjustment_pct") @db.Decimal
  predictedPriceCents      BigInt?   @map("predicted_price_cents")
  predictedBandLowCents    BigInt?   @map("predicted_band_low_cents")
  predictedBandHighCents   BigInt?   @map("predicted_band_high_cents")
  winProbability           Decimal?  @map("win_probability") @db.Decimal
  modifierDrivers          Json?     @map("modifier_drivers")
  // Tech-team pre-approval adjustment — null until a tech_team user
  // edits the predicted price. Bound to a specific prediction so a
  // re-predict stales the adjustment (UI ignores it when
  // techAdjustedPredictionId != latest prediction.id).
  techAdjustedPriceCents   BigInt?   @map("tech_adjusted_price_cents")
  techAdjustedAt           DateTime? @map("tech_adjusted_at") @db.Timestamptz
  techAdjustedBy           String?   @map("tech_adjusted_by") @db.Uuid
  techAdjustmentNote       String?   @map("tech_adjustment_note")
  techAdjustedPredictionId String?   @map("tech_adjusted_prediction_id") @db.Uuid
  // Manager approval / override — null until used.
  approvedPriceCents       BigInt?   @map("approved_price_cents")
  approvedAt               DateTime? @map("approved_at") @db.Timestamptz
  approvedBy               String?   @map("approved_by") @db.Uuid
  computedAt               DateTime  @default(now()) @map("computed_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  rateCard   RateCard?  @relation(fields: [rateCardId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([rateCardId])
  @@map("engagement_quotes")
}

model GatheringToken {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  engagementId          String    @map("engagement_id") @db.Uuid
  // argon2id hash of the plaintext token. Plaintext is shown to the client
  // exactly once (in the email). Only the hash hits the DB.
  tokenHash             String    @map("token_hash")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz
  // Set on first successful access. Used to detect material device changes
  // (different fingerprint or wildly different IP) on subsequent accesses.
  boundFingerprintHash  String?   @map("bound_fingerprint_hash")
  accessCount           Int       @default(0) @map("access_count")
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([engagementId])
  @@map("gathering_tokens")
}

model EngagementAnswer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  engagementId    String   @map("engagement_id") @db.Uuid
  nodeId          String   @map("node_id") @db.Uuid
  // Loop iteration this answer belongs to. 0 for non-loop answers; 0..N-1
  // for nodes inside a loop body where the responder iterated N times.
  iterationIndex  Int      @default(0) @map("iteration_index")
  // Answer is JSONB — string | string[] | number, see @rhud/shared Answer type.
  answer          Json
  answeredAt      DateTime @default(now()) @map("answered_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  // One answer per (engagement, node, iteration). Re-answers within the
  // same iteration UPSERT in place; new iteration writes a new row.
  @@unique([engagementId, nodeId, iterationIndex], map: "engagement_answers_eng_node_iter_key")
  @@index([tenantId])
  @@map("engagement_answers")
}

model EngagementFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  nodeId       String   @map("node_id") @db.Uuid
  // S3 object key — `engagements/<engagementId>/<uuid>/<filename>`.
  s3Key        String   @map("s3_key")
  filename     String
  sizeBytes    BigInt   @map("size_bytes")
  contentType  String   @map("content_type")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([engagementId])
  @@map("engagement_files")
}

model AuditChainLink {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  // Sequential per (tenant_id). Starts at 1; new tenant's first link is 1.
  sequence      Int
  // sha256 hex of (prevHash ?? '0'×64) || canonical(events covered).
  rootHash      String   @map("root_hash")
  prevHash      String?  @map("prev_hash")
  // Window covered by this link [from, to). Closed-open interval.
  fromCreatedAt DateTime @map("from_created_at") @db.Timestamptz
  toCreatedAt   DateTime @map("to_created_at") @db.Timestamptz
  eventCount    Int      @map("event_count")
  // ISO8601 of when this link was computed (not the same as the window).
  computedAt    DateTime @default(now()) @map("computed_at") @db.Timestamptz
  // S3 mirror status — null until mirrored to Object Lock; populated by
  // a background job in a later sprint. Not load-bearing for chain integrity.
  mirroredS3Key String?  @map("mirrored_s3_key")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sequence])
  @@index([tenantId, computedAt])
  @@map("audit_chain_links")
}

model ThreadEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  // Must be one of the values in @rhud/shared THREAD_EVENT_TYPES — design
  // doc §4.7 contract. CHECK constraint in migration SQL.
  eventType    String   @map("event_type")
  // 'user' | 'client' | 'system' | 'integration'
  actorType    String   @map("actor_type")
  // Free-form id of the actor (user UUID, client email, integration name).
  actorId      String?  @map("actor_id")
  // Event-specific payload; shape per event type lives in @rhud/shared types.
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([engagementId, createdAt])
  @@map("thread_events")
}

// ── Pricing engine: rate cards ──────────────────────────────────────────────
// Versioned, tenant-owned price book. Stage 2 of the pricing engine
// (deterministic base price) is a pure walk over service_lines + tiers.
// See Rhud_Pricing_Engine.pdf §2.2, §3.3.
model RateCard {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  version         Int      @default(1)
  // draft | published | archived — CHECK in migration.
  status          String   @default("draft")
  // ISO 4217 — INR / USD / EUR / GBP. Kept simple; FX in v1.1 per §7.
  currency        String   @default("INR")
  effectiveFrom   DateTime? @map("effective_from") @db.Timestamptz
  effectiveTo     DateTime? @map("effective_to")   @db.Timestamptz
  sourceFileKey   String?   @map("source_file_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt      @map("updated_at") @db.Timestamptz

  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceLines        RateCardServiceLine[]
  openPricedServices  RateCardOpenPricedService[]
  templates           Template[]
  engagementQuotes    EngagementQuote[]

  @@unique([tenantId, name, version], map: "rate_cards_tenant_name_version_uniq")
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("rate_cards")
}

model RateCardServiceLine {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  rateCardId    String  @map("rate_card_id") @db.Uuid
  // Machine identifier. Templates reference this in node mappings, so
  // the pricing engine can hop from a gathering answer to the right
  // service line. Stable across rate card versions.
  slug          String
  displayName   String  @map("display_name")
  // pages | screens | apis | loc | devices | hours | other — CHECK in migration.
  scopeUnit     String  @map("scope_unit")
  // tier_lookup | per_unit | flat | hourly — only tier_lookup is wired today.
  pricingModel  String  @default("tier_lookup") @map("pricing_model")
  position      Int     @default(0)

  rateCard RateCard            @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  tiers    RateCardTier[]

  @@unique([rateCardId, slug], map: "rate_card_service_lines_card_slug_uniq")
  @@index([tenantId])
  @@map("rate_card_service_lines")
}

model RateCardTier {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  serviceLineId   String  @map("service_line_id") @db.Uuid
  // Inclusive bounds. rangeMax NULL = open-ended ("200 & Above").
  rangeMin        Int     @map("range_min")
  rangeMax        Int?    @map("range_max")
  // 'grey_box' | 'black_box' | 'va' | 'pt' | null — service-line specific.
  methodology     String?
  // 'internal' | 'external' — CHECK in migration.
  customerType    String  @map("customer_type")
  priceCents      BigInt  @map("price_cents")
  // The original tier label as written in the source ("Upto 50",
  // "200 & Above") — surfaces in the proposal line items for traceability.
  displayLabel    String? @map("display_label")

  serviceLine RateCardServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Cascade)

  @@index([serviceLineId])
  @@index([tenantId])
  @@index([serviceLineId, customerType, methodology], map: "rate_card_tiers_lookup_idx")
  @@map("rate_card_tiers")
}

model RateCardOpenPricedService {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  rateCardId    String  @map("rate_card_id") @db.Uuid
  slug          String
  displayName   String  @map("display_name")
  category      String?
  position      Int     @default(0)

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, slug], map: "rate_card_open_priced_services_card_slug_uniq")
  @@index([tenantId])
  @@map("rate_card_open_priced_services")
}

model TemplateNode {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  // Denormalized from the parent template so RLS policies stay single-table.
  tenantId   String  @map("tenant_id") @db.Uuid
  question   String
  // For section nodes this is the heading description (longer body of copy).
  // For input nodes it's the helper text under the field.
  helpText   String? @map("help_text")
  // Optional placeholder shown inside text/number inputs.
  placeholder String?
  // If FALSE the responder may skip the question; defaults TRUE.
  required   Boolean @default(true)
  // single_select | multi_select | short_text | long_text | number |
  // file_upload | section | loop
  nodeType   String  @map("node_type")
  // For selects: [{value, label, desc?}]. Null otherwise.
  options    Json?
  allowFiles Boolean @default(false) @map("allow_files")
  // [{when: {op, value}, goto: <nodeId> | 'END'}, ...] — evaluated in order.
  nextRules  Json    @default("[]") @map("next_rules")
  // Display order in the editor; runtime order is dictated by nextRules.
  position   Int     @default(0)
  // Loop bodies: child nodes of a `loop` parent. Self-referential FK.
  parentNodeId String? @map("parent_node_id") @db.Uuid
  // Loop-specific config: { mode: 'open_ended', label?: 'Application',
  //                         serviceLineSlug?: 'vapt_web_app' }
  loopConfig   Json?   @map("loop_config")
  // Stage 1 binding: which rate-card dimension this answer fills.
  // { field: 'scope_value' | 'methodology' | 'customer_type',
  //   valueMap?: Record<string, string> }
  binding      Json?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Self-relation for loop body containment. Cascade delete drops the body
  // when the loop node is removed.
  parent   TemplateNode?  @relation("LoopBody", fields: [parentNodeId], references: [id], onDelete: Cascade)
  children TemplateNode[] @relation("LoopBody")

  @@index([templateId])
  @@index([tenantId])
  @@index([parentNodeId])
  @@map("template_nodes")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.Citext
  passwordHash String?  @map("password_hash")
  // CHECK constraint is added in the migration SQL.
  role         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  magicLinks   MagicLink[]
  integrations UserIntegration[]

  // Email is globally unique. Even across tenants we don't want two users
  // sharing an email — simpler mental model for the MVP.
  @@unique([email])
  @@index([tenantId])
  @@map("users")
}

/// Per-user OAuth-based email integrations (Outlook now, Gmail next).
/// One row per (user, provider). When a rep clicks "Send via Outlook"
/// in the proposal modal, the API uses these tokens to compose +
/// send the email from the rep's own account, with the proposal PDF
/// attached. Refresh tokens are persisted so we can keep working
/// without prompting again.
///
/// Reuses the same envelope encryption as TenantLlmConfig — DEK per
/// row, master key from LLM_KEY_ENCRYPTION_KEY.
model UserIntegration {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  /// 'outlook' | 'gmail' — CHECK constraint in migration.
  provider  String
  /// The address messages will be sent FROM (Microsoft `mail` claim,
  /// or Google `email`). Surfaced in the UI: "Connected as
  /// alex@acme.com".
  accountEmail String @map("account_email")

  /// Access token — usually short-lived (Microsoft: ~60 min).
  accessTokenCiphertext    Bytes  @map("access_token_ciphertext")
  accessTokenIv            Bytes  @map("access_token_iv")
  accessTokenDekCiphertext Bytes  @map("access_token_dek_ciphertext")
  accessTokenDekIv         Bytes  @map("access_token_dek_iv")
  accessTokenExpiresAt     DateTime @map("access_token_expires_at") @db.Timestamptz

  /// Refresh token — long-lived (Microsoft: ~90 days of inactivity).
  /// Optional because some flows (e.g. v1 client_credentials) don't
  /// return one, but our authcode flow always does.
  refreshTokenCiphertext    Bytes? @map("refresh_token_ciphertext")
  refreshTokenIv            Bytes? @map("refresh_token_iv")
  refreshTokenDekCiphertext Bytes? @map("refresh_token_dek_ciphertext")
  refreshTokenDekIv         Bytes? @map("refresh_token_dek_iv")

  /// Space-separated scope list as returned by the provider, for
  /// debugging "why doesn't sendMail work" tickets.
  scopes    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One integration per (user, provider). Re-connecting upserts.
  @@unique([userId, provider])
  @@index([tenantId])
  @@map("user_integrations")
}

model MagicLink {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // argon2id hash of the one-time token. Only the hash ever hits the DB.
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("magic_links")
}

// ── Adaptive pricing: predictions + per-tenant config ──────────────────────
//
// Predictions are append-only. A re-predict creates a new row; the latest
// (by created_at desc) is the active one. Older rows are preserved for
// audit + the manager UI's "what changed since last time" diffing.
model Prediction {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  engagementId          String   @map("engagement_id") @db.Uuid
  // 'cold_start' | 'rules' | 'linear' | 'boosted' — CHECK in migration.
  regime                String
  basePriceCents        BigInt   @map("base_price_cents")
  predictedPriceCents   BigInt   @map("predicted_price_cents")
  // Signed ratio (final/base − 1). Decimal, NOT_NULL with default 0.
  adjustmentPct         Decimal  @default(0) @map("adjustment_pct") @db.Decimal(6, 4)
  bandLowCents          BigInt   @map("band_low_cents")
  bandHighCents         BigInt   @map("band_high_cents")
  // Win-prob fields stay null until a classifier ships.
  winProbAtPredicted    Decimal? @map("win_prob_at_predicted") @db.Decimal(4, 3)
  winProbAtBase         Decimal? @map("win_prob_at_base")      @db.Decimal(4, 3)
  winProbAtBandLow      Decimal? @map("win_prob_at_band_low")  @db.Decimal(4, 3)
  drivers               Json     @default("[]")
  similarPast           Json     @default("[]") @map("similar_past")
  dataQuality           Json     @default("{}") @map("data_quality")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([engagementId, createdAt(sort: Desc)])
  @@map("predictions")
}

// Per-tenant tunables: regime thresholds, loyalty rules, manual modifiers,
// retrain hour. Stored in DB (not code) so a customer with thin data can
// opt to stay in rules longer if their early ML attempts looked unstable.
model TenantPricingConfig {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  loyaltyRules           Json     @default("[]") @map("loyalty_rules")
  manualModifiers        Json     @default("[]") @map("manual_modifiers")
  coldStartUntilNClosed  Int      @default(5)   @map("cold_start_until_n_closed")
  rulesUntilNClosed      Int      @default(30)  @map("rules_until_n_closed")
  linearUntilNClosed     Int      @default(100) @map("linear_until_n_closed")
  retrainHourUtc         Int      @default(2)   @map("retrain_hour_utc")
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_pricing_config")
}

/// Pending team invite. Token is stored hashed (argon2); plaintext only
/// exists in the email body. CHECK constraint mirrors the User role enum.
/// Lifecycle: created → (revoked_at | accepted_at) terminal. Expired rows
/// remain for audit; the accept endpoint rejects them.
model Invite {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @db.Citext
  role         String
  tokenHash    String    @map("token_hash")
  invitedById  String    @map("invited_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("invites")
}

/// Per-tenant LLM provider configuration. The API key is encrypted at rest
/// via envelope encryption — `api_key_ciphertext` holds the AES-GCM
/// payload, `api_key_dek_ciphertext` holds the DEK wrapped by the master
/// key (LLM_KEY_ENCRYPTION_KEY env, 32-byte base64). Decryption happens
/// only inside the LLM client; the key never leaves the API process.
model TenantLlmConfig {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  /// "anthropic" | "openai" | "ollama" | "openai_compat"
  provider             String
  /// Provider model id, e.g. "claude-opus-4-7", "gpt-4o-mini", "llama3.1:8b"
  model                String
  /// Override base URL — required for ollama / openai_compat / azure;
  /// null means "use the provider SDK's default".
  baseUrl              String?  @map("base_url")
  apiKeyCiphertext     Bytes?   @map("api_key_ciphertext")
  apiKeyIv             Bytes?   @map("api_key_iv")
  apiKeyDekCiphertext  Bytes?   @map("api_key_dek_ciphertext")
  apiKeyDekIv          Bytes?   @map("api_key_dek_iv")
  /// Soft cap so a runaway loop doesn't drain the tenant's quota. 0 = no cap.
  monthlyTokenBudget   Int      @default(0) @map("monthly_token_budget")
  enabled              Boolean  @default(true)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_llm_config")
}

/// Per-tenant Gamma integration. API key encrypted via the same
/// envelope scheme as TenantLlmConfig (master key in
/// `LLM_KEY_ENCRYPTION_KEY` env). `proposalDriver` lets the tenant
/// choose whether proposal drafts come from the LLM or from Gamma —
/// both write into the same `engagements.proposal_draft` slot, so the
/// downstream UI shape stays unified.
model TenantGammaConfig {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  /// Optional friendly label shown in the UI ("Acme Workspace").
  workspaceName        String?  @map("workspace_name")
  /// Optional Gamma workspace id when the API needs it (Gamma's
  /// docs use this for routing decks to a specific workspace).
  workspaceId          String?  @map("workspace_id")
  apiKeyCiphertext     Bytes?   @map("api_key_ciphertext")
  apiKeyIv             Bytes?   @map("api_key_iv")
  apiKeyDekCiphertext  Bytes?   @map("api_key_dek_ciphertext")
  apiKeyDekIv          Bytes?   @map("api_key_dek_iv")
  /// Which engine drafts proposals for this tenant.
  /// "llm" = use the configured LLM provider (default).
  /// "gamma" = use Gamma's deck generator.
  proposalDriver       String   @default("llm") @map("proposal_driver")
  enabled              Boolean  @default(true)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_gamma_config")
}
