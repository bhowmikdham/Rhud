// Rhud core schema.
// Sprint 1 scope: tenants, users, magic_links + RLS foundation.
// Later sprints add: templates, engagements, thread_events, tokens, files, ml_models.
//
// Tenant isolation contract:
//   - Every tenant-scoped table has RLS enabled + a policy keyed on
//     current_setting('app.tenant_id')::uuid.
//   - App code connects as the `rhud_app` role (NOBYPASSRLS) and must call
//     withTenant() before any DB access. See apps/api/src/db/with-tenant.ts.
//   - Migrations run as the superuser (DATABASE_URL); runtime uses APP_DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  plan        String   @default("mvp")
  // JSONB configs for external integrations; secrets live in KMS/Doppler,
  // these columns hold non-secret pointers (urls, workspace ids, etc.).
  odooConfig         Json?    @map("odoo_config")
  slackConfig        Json?    @map("slack_config")
  teamsConfig        Json?    @map("teams_config")
  gammaConfig        Json?    @map("gamma_config")
  // Per-tenant notification routing override. See @rhud/shared
  // TenantNotificationConfig. Null = use defaults.
  notificationConfig Json?    @map("notification_config")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  users           User[]
  magicLinks      MagicLink[]
  templates       Template[]
  engagements     Engagement[]
  auditChainLinks AuditChainLink[]
  rateCards       RateCard[]
  predictions     Prediction[]
  pricingConfig   TenantPricingConfig?
  invites         Invite[]
  llmConfig       TenantLlmConfig?
  gammaConfigRow  TenantGammaConfig?
  userIntegrations UserIntegration[]
  outlookApp      TenantOutlookApp?
  odooConnection   OdooConnection?
  odooFieldMaps    OdooFieldMapping[]
  odooSyncLogs     OdooSyncLog[]
  odooEntityLinks  OdooEntityLink[]
  odooWebhookEvents OdooWebhookEvent[]
  odooImported    OdooImportedOpportunity[]
  engagementTickets EngagementTicket[]
  engagementFollowUps EngagementFollowUp[]
  engagementSummaries EngagementSummary[]

  @@map("tenants")
}

/// Per-tenant Microsoft Entra app credentials. One row per workspace
/// (set up once by an admin via the UI). The app must be registered
/// as multi-tenant + personal accounts so any user signing in can
/// authorize it. The redirect URI is server-side derived (it's the
/// same for all tenants — points at our /integrations/outlook/callback)
/// so we don't store it; just display it in the setup modal.
///
/// The client secret is envelope-encrypted with the same DEK pattern
/// as TenantLlmConfig.
model TenantOutlookApp {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// The Application (client) ID from Entra — public, displayed back
  /// in the admin UI for sanity-check.
  clientId String @map("client_id")

  /// Encrypted client secret. Per-row DEK wrapped by the master key
  /// (LLM_KEY_ENCRYPTION_KEY).
  clientSecretCiphertext    Bytes @map("client_secret_ciphertext")
  clientSecretIv            Bytes @map("client_secret_iv")
  clientSecretDekCiphertext Bytes @map("client_secret_dek_ciphertext")
  clientSecretDekIv         Bytes @map("client_secret_dek_iv")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_outlook_app")
}

model Template {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  serviceLine String   @map("service_line")
  name        String
  version     Int      @default(1)
  // draft | published | archived — CHECK constraint in migration SQL.
  status      String   @default("draft")
  // FK to the first node in the tree. Nullable: new templates start empty.
  rootNodeId  String?  @map("root_node_id") @db.Uuid
  // Default rate card used for engagements issued from this template.
  // Null on legacy templates; quotes are computed iff the engagement's
  // template has one set at submission time.
  rateCardId  String?  @map("rate_card_id") @db.Uuid
  /// Optional Gamma template id. When proposal drafting routes through
  /// Gamma, this id is forwarded so the deck inherits the template's
  /// layout / theme. Null = let Gamma pick a default.
  gammaTemplateId String? @map("gamma_template_id")
  /// Optional proposal scaffold — Markdown with {{token}} merge fields.
  /// When set, proposal generation renders this scaffold (substituting
  /// data tokens like {{client_name}}, {{price}}, {{scope_summary}})
  /// instead of asking the LLM to compose from scratch. Gives the
  /// consultancy full control over boilerplate (values, terms,
  /// signature) while only the dynamic parts vary per opportunity.
  proposalScaffold String? @map("proposal_scaffold")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rateCard    RateCard?      @relation(fields: [rateCardId], references: [id], onDelete: SetNull)
  nodes       TemplateNode[]
  engagements Engagement[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([rateCardId])
  @@map("templates")
}

// ── Sprint 3: engagements, gathering, threads, files ────────────────────────

model Engagement {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  templateId          String   @map("template_id") @db.Uuid
  // Snapshot of the template version this engagement was issued against, so
  // editing the template later doesn't change in-flight engagements.
  templateVersion     Int      @default(1) @map("template_version")
  salesEmployeeId     String   @map("sales_employee_id") @db.Uuid
  salesManagerId      String?  @map("sales_manager_id") @db.Uuid
  clientEmail         String   @map("client_email") @db.Citext
  // Free-text label shown in the UI ("Acme Q3 Security Assessment"). The
  // table itself is still called engagements for historical reasons; the
  // user-facing concept is "Opportunity".
  name                String?
  // Lifecycle — see @rhud/shared ENGAGEMENT_STATUSES. CHECK in migration.
  status              String   @default("issued")
  predictedPriceCents BigInt?  @map("predicted_price_cents")
  priceLowCents       BigInt?  @map("price_low_cents")
  priceHighCents      BigInt?  @map("price_high_cents")
  approvedPriceCents  BigInt?  @map("approved_price_cents")
  // Snapshot of closed-engagement count for this tenant at predict-time.
  // Pinned so a re-evaluation later doesn't shift regime under our feet.
  closedEngagementCountSnapshot Int? @map("closed_engagement_count_snapshot")
  odooQuotationId     String?  @map("odoo_quotation_id")
  /// True when this Engagement was promoted from an Odoo crm.lead
  /// snapshot rather than issued natively in Rhud. The gathering
  /// flow + outbound Odoo push are skipped for these (the canonical
  /// source is Odoo; we mirror it).
  importedFromOdoo    Boolean  @default(false) @map("imported_from_odoo")
  // Loop cursor state, keyed by loop node id:
  //   { "<loopNodeId>": { iter: <currentIteration>, status: 'iterating'|'done' } }
  // The runtime updates this as the responder enters/exits each loop;
  // findCurrentNode reads it to know which body iteration to show.
  loopState           Json     @default("{}") @map("loop_state")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  submittedAt         DateTime? @map("submitted_at") @db.Timestamptz
  closedAt            DateTime? @map("closed_at") @db.Timestamptz

  /// Current AI-generated proposal draft. Single column (one draft at a
  /// time) — regenerate replaces. Persists from `drafting` through `sent`
  /// so the rep can copy it into their email client at any point.
  proposalDraft       String?   @map("proposal_draft")
  proposalDraftedAt   DateTime? @map("proposal_drafted_at") @db.Timestamptz
  /// Provider that produced the current draft, e.g. 'anthropic',
  /// 'manual', 'gamma'. Surfaced in the UI so reps know what to
  /// expect (inline text vs link to a Gamma deck).
  proposalDraftSource String?   @map("proposal_draft_source")
  /// When the draft was produced by Gamma — the deck's URL + id.
  /// For LLM drafts these stay null and the text lives in proposalDraft.
  gammaDeckUrl        String?   @map("gamma_deck_url")
  gammaDeckId         String?   @map("gamma_deck_id")
  /// Gamma's generation job id — set while a Gamma deck is being
  /// drafted, cleared once the deck is ready (or failed). Used by
  /// getCurrent() to poll Gamma's status endpoint without re-running
  /// the create call.
  gammaGenerationId        String?   @map("gamma_generation_id")
  gammaGenerationStartedAt DateTime? @map("gamma_generation_started_at") @db.Timestamptz

  /// PDF export of the current proposal — surfaced as the attachment in
  /// the Send-to-client modal. Populated for Gamma drafts via the
  /// `exportAs: 'pdf'` flag at generation time. Gamma export URLs
  /// expire after ~7 days (per the public docs); we cache the
  /// approximate expiry so the UI can prompt the rep to regenerate
  /// instead of handing them a dead link.
  proposalPdfUrl       String?   @map("proposal_pdf_url")
  proposalPdfExpiresAt DateTime? @map("proposal_pdf_expires_at") @db.Timestamptz

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template        Template           @relation(fields: [templateId], references: [id])
  tokens          GatheringToken[]
  answers         EngagementAnswer[]
  files           EngagementFile[]
  events          ThreadEvent[]
  quote           EngagementQuote?
  predictions     Prediction[]
  tickets         EngagementTicket[]
  followUps       EngagementFollowUp[]
  summary         EngagementSummary?
  siteEnumeration SiteEnumeration?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([salesEmployeeId])
  @@map("engagements")
}

// Persisted output of the deterministic Stage 2 base price computation,
// plus space for Stage 3 modifier predictions and manager overrides.
// One per engagement; recomputed on submit.
model EngagementQuote {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  engagementId             String    @unique @map("engagement_id") @db.Uuid
  rateCardId               String?   @map("rate_card_id") @db.Uuid
  rateCardVersion          Int       @map("rate_card_version")
  currency                 String
  baseTotalCents           BigInt    @map("base_total_cents")
  baseBreakdown            Json      @map("base_breakdown")
  // Stage 3 (modifier) — nullable until ML lands.
  predictedAdjustmentPct   Decimal?  @map("predicted_adjustment_pct") @db.Decimal
  predictedPriceCents      BigInt?   @map("predicted_price_cents")
  predictedBandLowCents    BigInt?   @map("predicted_band_low_cents")
  predictedBandHighCents   BigInt?   @map("predicted_band_high_cents")
  winProbability           Decimal?  @map("win_probability") @db.Decimal
  modifierDrivers          Json?     @map("modifier_drivers")
  // Tech-team pre-approval adjustment — null until a tech_team user
  // edits the predicted price. Bound to a specific prediction so a
  // re-predict stales the adjustment (UI ignores it when
  // techAdjustedPredictionId != latest prediction.id).
  techAdjustedPriceCents   BigInt?   @map("tech_adjusted_price_cents")
  techAdjustedAt           DateTime? @map("tech_adjusted_at") @db.Timestamptz
  techAdjustedBy           String?   @map("tech_adjusted_by") @db.Uuid
  techAdjustmentNote       String?   @map("tech_adjustment_note")
  techAdjustedPredictionId String?   @map("tech_adjusted_prediction_id") @db.Uuid
  // Manager approval / override — null until used.
  approvedPriceCents       BigInt?   @map("approved_price_cents")
  approvedAt               DateTime? @map("approved_at") @db.Timestamptz
  approvedBy               String?   @map("approved_by") @db.Uuid
  computedAt               DateTime  @default(now()) @map("computed_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  rateCard   RateCard?  @relation(fields: [rateCardId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([rateCardId])
  @@map("engagement_quotes")
}

model GatheringToken {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  engagementId          String    @map("engagement_id") @db.Uuid
  // argon2id hash of the plaintext token. Used for verification on
  // every /g/:token access (constant-time compare via argon2id.verify).
  tokenHash             String    @map("token_hash")
  // Plaintext token kept so the sales rep can look the URL up later
  // (copy back into chat, share with a teammate, etc.). Trade-off
  // accepted in dev/sales setting: short-lived single-use tokens +
  // revokedAt limit blast radius if the DB is compromised.
  tokenPlain            String?   @map("token_plain")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz
  // Set on first successful access. Used to detect material device changes
  // (different fingerprint or wildly different IP) on subsequent accesses.
  boundFingerprintHash  String?   @map("bound_fingerprint_hash")
  accessCount           Int       @default(0) @map("access_count")
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([engagementId])
  @@map("gathering_tokens")
}

model EngagementAnswer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  engagementId    String   @map("engagement_id") @db.Uuid
  nodeId          String   @map("node_id") @db.Uuid
  // Loop iteration this answer belongs to. 0 for non-loop answers; 0..N-1
  // for nodes inside a loop body where the responder iterated N times.
  iterationIndex  Int      @default(0) @map("iteration_index")
  // Answer is JSONB — string | string[] | number, see @rhud/shared Answer type.
  answer          Json
  answeredAt      DateTime @default(now()) @map("answered_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  // One answer per (engagement, node, iteration). Re-answers within the
  // same iteration UPSERT in place; new iteration writes a new row.
  @@unique([engagementId, nodeId, iterationIndex], map: "engagement_answers_eng_node_iter_key")
  @@index([tenantId])
  @@map("engagement_answers")
}

model EngagementFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  // NULL when the file is a scoping document uploaded at the
  // engagement level (Quick-fill flow). Non-null when the responder
  // attached the file to a specific template question.
  nodeId       String?  @map("node_id") @db.Uuid
  /// 'scoping_doc' — Quick-fill upload before answering any question.
  /// 'node_attachment' — file attached to a specific question (file_upload
  /// node OR a regular node with allowFiles=true). Default for legacy rows.
  kind         String   @default("node_attachment")
  // S3 object key — `engagements/<engagementId>/<uuid>/<filename>`.
  s3Key        String   @map("s3_key")
  filename     String
  sizeBytes    BigInt   @map("size_bytes")
  contentType  String   @map("content_type")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  /// Document-extraction pipeline state.
  ///   pending      — uploaded, not yet processed
  ///   processing   — text extraction + LLM structuring in flight
  ///   ready        — extractedPoints + extractedText populated
  ///   failed       — see extractionError for the human-readable cause
  ///   skipped      — content type isn't supported (e.g. video)
  ///   retry_queued — provider rate-limited; a cron will retry at retryAt
  extractionStatus    String?   @map("extraction_status")
  extractionStartedAt DateTime? @map("extraction_started_at") @db.Timestamptz
  extractedAt         DateTime? @map("extracted_at") @db.Timestamptz
  extractionError     String?   @map("extraction_error")
  /// When extractionStatus = 'retry_queued', the cron picks up rows
  /// where retryAt <= now() and re-fires kickoff. Null otherwise.
  /// Resets to null on terminal outcome.
  extractionRetryAt   DateTime? @map("extraction_retry_at") @db.Timestamptz
  /// Number of retry attempts so far. Cron stops retrying after 5
  /// and flips to `failed` so the row doesn't loop forever.
  extractionAttempts  Int       @default(0) @map("extraction_attempts")
  /// Raw text we pulled out of the file (PDF text layer, xlsx cells,
  /// plain text). Capped at ~200KB on insert; longer documents get the
  /// head + tail with a marker. Stored so re-running the LLM step
  /// doesn't require re-fetching from S3.
  extractedText       String?   @map("extracted_text")
  /// Structured data points the LLM pulled out, shaped as
  ///   [{ key, value, sourceQuote, relatedQuestion?, category? }]
  /// JSON because the schema is per-tenant + may evolve. `category`
  /// is added by Layer 2 (semantic classification) — see
  /// CategoryClassifierService. Values: scope|methodology|service_type
  /// |identity|environment|compliance|other.
  extractedPoints     Json?     @map("extracted_points")
  /// Cached output of the rate-card field mapper (Layer 3) for this
  /// file. Shape:
  ///   [{ serviceLineSlug, scopeValue, methodology, customerType,
  ///      confidence, reasoning, sourceQuote }]
  /// Computed once at extraction time so Re-predict doesn't re-call
  /// the LLM. Null until the mapper has run.
  inferredEntities    Json?     @map("inferred_entities")
  /// Canonical Layer-1.5 RhudDocument representation: every cell from
  /// xlsx, every page from PDF, every heading-bounded block from docx —
  /// captured BEFORE any LLM step runs. Used by the admin-review UI to
  /// show "this is what the parser saw" so parsing-quality issues are
  /// debuggable separately from LLM-quality issues. See
  /// packages/shared/src/document.ts (RhudDocument).
  parsedDocument      Json?     @map("parsed_document")

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([engagementId])
  @@index([engagementId, extractionStatus])
  @@map("engagement_files")
}

model AuditChainLink {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  // Sequential per (tenant_id). Starts at 1; new tenant's first link is 1.
  sequence      Int
  // sha256 hex of (prevHash ?? '0'×64) || canonical(events covered).
  rootHash      String   @map("root_hash")
  prevHash      String?  @map("prev_hash")
  // Window covered by this link [from, to). Closed-open interval.
  fromCreatedAt DateTime @map("from_created_at") @db.Timestamptz
  toCreatedAt   DateTime @map("to_created_at") @db.Timestamptz
  eventCount    Int      @map("event_count")
  // ISO8601 of when this link was computed (not the same as the window).
  computedAt    DateTime @default(now()) @map("computed_at") @db.Timestamptz
  // S3 mirror status — null until mirrored to Object Lock; populated by
  // a background job in a later sprint. Not load-bearing for chain integrity.
  mirroredS3Key String?  @map("mirrored_s3_key")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sequence])
  @@index([tenantId, computedAt])
  @@map("audit_chain_links")
}

model ThreadEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  // Must be one of the values in @rhud/shared THREAD_EVENT_TYPES — design
  // doc §4.7 contract. CHECK constraint in migration SQL.
  eventType    String   @map("event_type")
  // 'user' | 'client' | 'system' | 'integration'
  actorType    String   @map("actor_type")
  // Free-form id of the actor (user UUID, client email, integration name).
  actorId      String?  @map("actor_id")
  // Event-specific payload; shape per event type lives in @rhud/shared types.
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([engagementId, createdAt])
  @@map("thread_events")
}

// ── Pricing engine: rate cards ──────────────────────────────────────────────
// Versioned, tenant-owned price book. Stage 2 of the pricing engine
// (deterministic base price) is a pure walk over service_lines + tiers.
// See Rhud_Pricing_Engine.pdf §2.2, §3.3.
model RateCard {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  version         Int      @default(1)
  // draft | published | archived — CHECK in migration.
  status          String   @default("draft")
  // ISO 4217 — INR / USD / EUR / GBP. Kept simple; FX in v1.1 per §7.
  currency        String   @default("INR")
  effectiveFrom   DateTime? @map("effective_from") @db.Timestamptz
  effectiveTo     DateTime? @map("effective_to")   @db.Timestamptz
  sourceFileKey   String?   @map("source_file_key")
  // Layer-3 mapper prompt synthesis — see migration
  // 20260609000000_rate_card_inference_ontology and design notes in
  // packages/shared/src/pricing.ts (RateCard.inferenceContext).
  // The mapper composes its system prompt from these fields so it never
  // bakes domain (cybersec, cleaning, legal, …) into code.
  inferenceContext         String?  @map("inference_context")
  defaultMethodologyRule   String?  @map("default_methodology_rule")
  inferenceExamples        Json     @default("[]") @map("inference_examples")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt      @map("updated_at") @db.Timestamptz

  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceLines        RateCardServiceLine[]
  openPricedServices  RateCardOpenPricedService[]
  templates           Template[]
  engagementQuotes    EngagementQuote[]

  @@unique([tenantId, name, version], map: "rate_cards_tenant_name_version_uniq")
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("rate_cards")
}

model RateCardServiceLine {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  rateCardId    String  @map("rate_card_id") @db.Uuid
  // Machine identifier. Templates reference this in node mappings, so
  // the pricing engine can hop from a gathering answer to the right
  // service line. Stable across rate card versions.
  slug          String
  displayName   String  @map("display_name")
  // pages | screens | apis | loc | devices | hours | other — CHECK in migration.
  scopeUnit     String  @map("scope_unit")
  // tier_lookup | per_unit | flat | hourly — only tier_lookup is wired today.
  pricingModel  String  @default("tier_lookup") @map("pricing_model")
  position      Int     @default(0)
  // Layer-3 mapper prompt synthesis — see migration
  // 20260609000000_rate_card_inference_ontology and design notes in
  // packages/shared/src/pricing.ts (RateCardServiceLine.inferenceHint).
  inferenceHint     String?  @map("inference_hint")
  inferenceExamples Json     @default("[]") @map("inference_examples")

  rateCard RateCard            @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  tiers    RateCardTier[]

  @@unique([rateCardId, slug], map: "rate_card_service_lines_card_slug_uniq")
  @@index([tenantId])
  @@map("rate_card_service_lines")
}

model RateCardTier {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  serviceLineId   String  @map("service_line_id") @db.Uuid
  // Inclusive bounds. rangeMax NULL = open-ended ("200 & Above").
  rangeMin        Int     @map("range_min")
  rangeMax        Int?    @map("range_max")
  // 'grey_box' | 'black_box' | 'va' | 'pt' | null — service-line specific.
  methodology     String?
  // 'internal' | 'external' — CHECK in migration.
  customerType    String  @map("customer_type")
  priceCents      BigInt  @map("price_cents")
  // The original tier label as written in the source ("Upto 50",
  // "200 & Above") — surfaces in the proposal line items for traceability.
  displayLabel    String? @map("display_label")

  serviceLine RateCardServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Cascade)

  @@index([serviceLineId])
  @@index([tenantId])
  @@index([serviceLineId, customerType, methodology], map: "rate_card_tiers_lookup_idx")
  @@map("rate_card_tiers")
}

model RateCardOpenPricedService {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  rateCardId    String  @map("rate_card_id") @db.Uuid
  slug          String
  displayName   String  @map("display_name")
  category      String?
  position      Int     @default(0)

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, slug], map: "rate_card_open_priced_services_card_slug_uniq")
  @@index([tenantId])
  @@map("rate_card_open_priced_services")
}

model TemplateNode {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  // Denormalized from the parent template so RLS policies stay single-table.
  tenantId   String  @map("tenant_id") @db.Uuid
  question   String
  // For section nodes this is the heading description (longer body of copy).
  // For input nodes it's the helper text under the field.
  helpText   String? @map("help_text")
  // Optional placeholder shown inside text/number inputs.
  placeholder String?
  // If FALSE the responder may skip the question; defaults TRUE.
  required   Boolean @default(true)
  // single_select | multi_select | short_text | long_text | number |
  // file_upload | section | loop
  nodeType   String  @map("node_type")
  // For selects: [{value, label, desc?}]. Null otherwise.
  options    Json?
  allowFiles Boolean @default(false) @map("allow_files")
  // [{when: {op, value}, goto: <nodeId> | 'END'}, ...] — evaluated in order.
  nextRules  Json    @default("[]") @map("next_rules")
  // Display order in the editor; runtime order is dictated by nextRules.
  position   Int     @default(0)
  // Loop bodies: child nodes of a `loop` parent. Self-referential FK.
  parentNodeId String? @map("parent_node_id") @db.Uuid
  // Loop-specific config: { mode: 'open_ended', label?: 'Application',
  //                         serviceLineSlug?: 'vapt_web_app' }
  loopConfig   Json?   @map("loop_config")
  // Stage 1 binding: which rate-card dimension this answer fills.
  // { field: 'scope_value' | 'methodology' | 'customer_type',
  //   valueMap?: Record<string, string> }
  binding      Json?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Self-relation for loop body containment. Cascade delete drops the body
  // when the loop node is removed.
  parent   TemplateNode?  @relation("LoopBody", fields: [parentNodeId], references: [id], onDelete: Cascade)
  children TemplateNode[] @relation("LoopBody")

  @@index([templateId])
  @@index([tenantId])
  @@index([parentNodeId])
  @@map("template_nodes")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.Citext
  passwordHash String?  @map("password_hash")
  // CHECK constraint is added in the migration SQL.
  role         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  magicLinks   MagicLink[]
  integrations UserIntegration[]

  // Email is globally unique. Even across tenants we don't want two users
  // sharing an email — simpler mental model for the MVP.
  @@unique([email])
  @@index([tenantId])
  @@map("users")
}

/// Per-user OAuth-based email integrations (Outlook now, Gmail next).
/// One row per (user, provider). When a rep clicks "Send via Outlook"
/// in the proposal modal, the API uses these tokens to compose +
/// send the email from the rep's own account, with the proposal PDF
/// attached. Refresh tokens are persisted so we can keep working
/// without prompting again.
///
/// Reuses the same envelope encryption as TenantLlmConfig — DEK per
/// row, master key from LLM_KEY_ENCRYPTION_KEY.
model UserIntegration {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  /// 'outlook' | 'gmail' — CHECK constraint in migration.
  provider  String
  /// The address messages will be sent FROM (Microsoft `mail` claim,
  /// or Google `email`). Surfaced in the UI: "Connected as
  /// alex@acme.com".
  accountEmail String @map("account_email")

  /// Access token — usually short-lived (Microsoft: ~60 min).
  accessTokenCiphertext    Bytes  @map("access_token_ciphertext")
  accessTokenIv            Bytes  @map("access_token_iv")
  accessTokenDekCiphertext Bytes  @map("access_token_dek_ciphertext")
  accessTokenDekIv         Bytes  @map("access_token_dek_iv")
  accessTokenExpiresAt     DateTime @map("access_token_expires_at") @db.Timestamptz

  /// Refresh token — long-lived (Microsoft: ~90 days of inactivity).
  /// Optional because some flows (e.g. v1 client_credentials) don't
  /// return one, but our authcode flow always does.
  refreshTokenCiphertext    Bytes? @map("refresh_token_ciphertext")
  refreshTokenIv            Bytes? @map("refresh_token_iv")
  refreshTokenDekCiphertext Bytes? @map("refresh_token_dek_ciphertext")
  refreshTokenDekIv         Bytes? @map("refresh_token_dek_iv")

  /// Space-separated scope list as returned by the provider, for
  /// debugging "why doesn't sendMail work" tickets.
  scopes    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One integration per (user, provider). Re-connecting upserts.
  @@unique([userId, provider])
  @@index([tenantId])
  @@map("user_integrations")
}

model MagicLink {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // argon2id hash of the one-time token. Only the hash ever hits the DB.
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("magic_links")
}

// ── Adaptive pricing: predictions + per-tenant config ──────────────────────
//
// Predictions are append-only. A re-predict creates a new row; the latest
// (by created_at desc) is the active one. Older rows are preserved for
// audit + the manager UI's "what changed since last time" diffing.
model Prediction {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  engagementId          String   @map("engagement_id") @db.Uuid
  // 'cold_start' | 'rules' | 'linear' | 'boosted' — CHECK in migration.
  regime                String
  basePriceCents        BigInt   @map("base_price_cents")
  predictedPriceCents   BigInt   @map("predicted_price_cents")
  // Signed ratio (final/base − 1). Decimal, NOT_NULL with default 0.
  adjustmentPct         Decimal  @default(0) @map("adjustment_pct") @db.Decimal(6, 4)
  bandLowCents          BigInt   @map("band_low_cents")
  bandHighCents         BigInt   @map("band_high_cents")
  // Win-prob fields stay null until a classifier ships.
  winProbAtPredicted    Decimal? @map("win_prob_at_predicted") @db.Decimal(4, 3)
  winProbAtBase         Decimal? @map("win_prob_at_base")      @db.Decimal(4, 3)
  winProbAtBandLow      Decimal? @map("win_prob_at_band_low")  @db.Decimal(4, 3)
  drivers               Json     @default("[]")
  similarPast           Json     @default("[]") @map("similar_past")
  dataQuality           Json     @default("{}") @map("data_quality")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([engagementId, createdAt(sort: Desc)])
  @@map("predictions")
}

// Per-tenant tunables: regime thresholds, loyalty rules, manual modifiers,
// retrain hour. Stored in DB (not code) so a customer with thin data can
// opt to stay in rules longer if their early ML attempts looked unstable.
model TenantPricingConfig {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  loyaltyRules           Json     @default("[]") @map("loyalty_rules")
  manualModifiers        Json     @default("[]") @map("manual_modifiers")
  coldStartUntilNClosed  Int      @default(5)   @map("cold_start_until_n_closed")
  rulesUntilNClosed      Int      @default(30)  @map("rules_until_n_closed")
  linearUntilNClosed     Int      @default(100) @map("linear_until_n_closed")
  retrainHourUtc         Int      @default(2)   @map("retrain_hour_utc")
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_pricing_config")
}

/// Pending team invite. Token is stored hashed (argon2); plaintext only
/// exists in the email body. CHECK constraint mirrors the User role enum.
/// Lifecycle: created → (revoked_at | accepted_at) terminal. Expired rows
/// remain for audit; the accept endpoint rejects them.
model Invite {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @db.Citext
  role         String
  tokenHash    String    @map("token_hash")
  invitedById  String    @map("invited_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("invites")
}

/// Per-tenant LLM provider configuration. The API key is encrypted at rest
/// via envelope encryption — `api_key_ciphertext` holds the AES-GCM
/// payload, `api_key_dek_ciphertext` holds the DEK wrapped by the master
/// key (LLM_KEY_ENCRYPTION_KEY env, 32-byte base64). Decryption happens
/// only inside the LLM client; the key never leaves the API process.
model TenantLlmConfig {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  /// "anthropic" | "openai" | "ollama" | "openai_compat"
  provider             String
  /// Provider model id, e.g. "claude-opus-4-7", "gpt-4o-mini", "llama3.1:8b"
  model                String
  /// Override base URL — required for ollama / openai_compat / azure;
  /// null means "use the provider SDK's default".
  baseUrl              String?  @map("base_url")
  apiKeyCiphertext     Bytes?   @map("api_key_ciphertext")
  apiKeyIv             Bytes?   @map("api_key_iv")
  apiKeyDekCiphertext  Bytes?   @map("api_key_dek_ciphertext")
  apiKeyDekIv          Bytes?   @map("api_key_dek_iv")
  /// Soft cap so a runaway loop doesn't drain the tenant's quota. 0 = no cap.
  monthlyTokenBudget   Int      @default(0) @map("monthly_token_budget")
  enabled              Boolean  @default(true)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_llm_config")
}

/// Per-tenant Odoo (cloud) connection. Stores the URL, database, and
/// integration login + API key so the API can call XML-RPC on the
/// customer's behalf. The api_key is envelope-encrypted with the same
/// DEK pattern as TenantLlmConfig — master key in LLM_KEY_ENCRYPTION_KEY.
///
/// Lifecycle: admin sets it up via /integrations/odoo, we test the
/// credentials by calling `common.authenticate`, and store the
/// returned uid for fast subsequent calls. Disconnecting wipes the
/// row + cascades all OdooEntityLink + OdooSyncLog rows.
model OdooConnection {
  tenantId   String  @id @map("tenant_id") @db.Uuid
  /// The Odoo instance URL — e.g. https://acme.odoo.com. No trailing slash.
  url        String
  /// Odoo database name. On odoo.com Online this is usually the
  /// subdomain (e.g. "acme").
  database   String
  /// Login email of the integration user. Stored in cleartext — it's not
  /// secret on its own; the api_key is.
  login      String
  /// Cached uid returned by the last successful authenticate(). Refreshed
  /// on connection-test or first call after a 401.
  uid        Int?
  /// Encrypted Odoo API key (envelope-wrapped DEK + ciphertext).
  apiKeyCiphertext    Bytes  @map("api_key_ciphertext")
  apiKeyIv            Bytes  @map("api_key_iv")
  apiKeyDekCiphertext Bytes  @map("api_key_dek_ciphertext")
  apiKeyDekIv         Bytes  @map("api_key_dek_iv")
  /// Auto-sync flag — when true, engagement lifecycle events (submitted,
  /// approved, won, lost, abandoned) push to Odoo automatically.
  autoSyncEnabled Boolean @default(true) @map("auto_sync_enabled")
  /// Default crm.team to associate new opportunities with. Optional.
  defaultTeamId   Int?    @map("default_team_id")
  /// Default res.users (salesperson) for new opportunities. Optional.
  defaultUserId   Int?    @map("default_user_id")
  /// Webhook shared secret — long random string the customer pastes into
  /// their Odoo Automation Rule URL as a query parameter. Lets us
  /// authenticate inbound webhooks without per-request signing (which
  /// Odoo Studio doesn't support natively).
  webhookSecret   String  @map("webhook_secret")
  /// Last time we successfully called Odoo; null on never.
  lastConnectedAt DateTime? @map("last_connected_at") @db.Timestamptz
  /// Last error string from a failed call — surfaced in the UI so the
  /// admin can see "credentials rejected" without reading logs.
  lastErrorMessage String?  @map("last_error_message")
  /// Odoo server version reported on authenticate(). Display-only.
  serverVersion   String?  @map("server_version")
  /// Polling cursor — the highest `create_date` of any crm.lead we've
  /// already pulled. The poller's next call uses
  /// `[['create_date', '>', last_polled_at]]` as its domain so we only
  /// catch *new* opportunities, not edits to old ones. Updates to
  /// already-promoted Engagements come in via Studio webhooks (when
  /// available) or the per-row Refresh button. NULL on a fresh tenant;
  /// first poll uses `now − pollIntervalSeconds` as the lookback floor.
  lastPolledAt DateTime? @map("last_polled_at") @db.Timestamptz
  /// Polling cadence in seconds. 0 = polling disabled (the tenant is on
  /// the Custom plan and uses Studio webhooks exclusively). Default 300
  /// keeps us politely under Odoo's ~1 req/sec AUP limit while still
  /// surfacing changes within ~5 minutes for non-Studio tenants.
  pollIntervalSeconds Int @default(300) @map("poll_interval_seconds")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("odoo_connections")
}

/// Per-tenant configurable field mapping from Rhud entities → Odoo
/// fields. Lets each customer decide e.g. "send our `name` as Odoo
/// `name` plus `description`", or "always set `priority='2'` on
/// outgoing opportunities". Default mappings are applied if no row.
///
/// Identity:
///   rhudEntity ∈ ('engagement', 'engagement_quote', 'engagement_thread')
///   odooModel  = 'crm.lead' | 'res.partner' | 'crm.tag' | etc.
model OdooFieldMapping {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  /// Source Rhud entity name.
  rhudEntity String  @map("rhud_entity")
  /// Source field path inside that entity (e.g. "name", "clientEmail",
  /// "approvedPriceCents", "quote.baseTotalCents", "answers.scope_value").
  rhudField  String  @map("rhud_field")
  /// Target Odoo model and field.
  odooModel  String  @map("odoo_model")
  odooField  String  @map("odoo_field")
  /// Optional value transform expression. Recognised verbs:
  ///   - "cents_to_currency"  → divide by 100, round to 2dp.
  ///   - "json_stringify"     → JSON.stringify(value).
  ///   - "uppercase" / "lowercase".
  ///   - "constant:<value>"   → ignore source, always set <value>.
  transform  String?
  /// When true the mapping is enforced on writes (and a missing source
  /// raises a sync error). When false, the field is optional and skipped
  /// when source is null/undefined.
  required   Boolean @default(false)
  /// Direction: 'push' = Rhud → Odoo, 'pull' = Odoo → Rhud, 'both'.
  direction  String  @default("push")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, rhudEntity, rhudField, odooModel, odooField, direction], map: "odoo_field_mappings_uniq")
  @@index([tenantId])
  @@map("odoo_field_mappings")
}

/// Mapping table linking Rhud entities to their Odoo counterparts so we
/// can update instead of duplicating. Examples:
///   ('engagement', '<engagement-uuid>', 'crm.lead', 12345)
///   ('engagement', '<engagement-uuid>', 'res.partner', 678)
///   ('client_account', 'alex@acme.com', 'res.partner', 9101)
model OdooEntityLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  rhudEntity  String   @map("rhud_entity")
  rhudId      String   @map("rhud_id")
  odooModel   String   @map("odoo_model")
  odooId      Int      @map("odoo_id")
  /// Last time we successfully synced this link (push or pull).
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz
  /// Last write_date observed from Odoo — used as the polling cursor for
  /// inbound change detection on this record.
  odooWriteDate DateTime? @map("odoo_write_date") @db.Timestamptz
  /// Cached canonical Odoo snapshot (after the inbound processor
  /// re-fetched the record). Used to render imported opportunities in
  /// the UI without round-tripping XML-RPC each time.
  cachedRecord  Json?     @map("cached_record")
  /// When the cached snapshot was last refreshed.
  cachedAt      DateTime? @map("cached_at") @db.Timestamptz
  /// When Rhud last successfully wrote to this Odoo record. The
  /// inbound processor uses this to suppress echo loops — if Odoo's
  /// write_date is within ~30s of last_pushed_at, we assume the
  /// inbound event is just our own push echoing back.
  lastPushedAt  DateTime? @map("last_pushed_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, rhudEntity, rhudId, odooModel], map: "odoo_entity_links_rhud_uniq")
  @@unique([tenantId, odooModel, odooId], map: "odoo_entity_links_odoo_uniq")
  @@index([tenantId])
  @@index([tenantId, odooWriteDate(sort: Desc)], map: "odoo_entity_links_write_date_idx")
  @@map("odoo_entity_links")
}

/// Snapshots of Odoo opportunities (crm.lead) that came from Odoo but
/// haven't been promoted to a Rhud Engagement yet. Distinct from
/// OdooEntityLink because Rhud Engagements require fields Odoo's
/// crm.lead doesn't carry (templateId, salesEmployeeId), so we need
/// a place to park the data while a user picks those.
///
/// Promotion is one-way: snapshot → Engagement. The row stays after
/// promotion (with `promoted_engagement_id` set) for audit history.
model OdooImportedOpportunity {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  /// Always 'crm.lead' today. Future-proofed for opportunity-equivalents
  /// in other Odoo modules (e.g. `sale.order` for finished quotes).
  odooModel            String    @default("crm.lead") @map("odoo_model")
  odooId               Int       @map("odoo_id")
  /// Canonical snapshot fetched directly from Odoo (never the raw
  /// webhook payload). Refreshed on every inbound sync tick.
  snapshot             Json
  /// Odoo's write_date from the snapshot. Used as the per-record
  /// idempotency cursor.
  odooWriteDate        DateTime? @map("odoo_write_date") @db.Timestamptz
  /// Set when a user has promoted this snapshot to a real Rhud
  /// Engagement via the /promote endpoint. Once set, future inbound
  /// sync ticks update both this snapshot AND the linked Engagement.
  promotedEngagementId String?   @map("promoted_engagement_id") @db.Uuid
  promotedAt           DateTime? @map("promoted_at") @db.Timestamptz
  promotedBy           String?   @map("promoted_by") @db.Uuid
  importedAt           DateTime  @default(now()) @map("imported_at") @db.Timestamptz
  lastRefreshedAt      DateTime  @default(now()) @map("last_refreshed_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, odooModel, odooId], map: "odoo_imported_opportunities_uniq")
  @@index([tenantId])
  @@map("odoo_imported_opportunities")
}

/// Append-only log of every Odoo sync attempt. Surfaced in the
/// /integrations/odoo dashboard so admins can see what synced when,
/// and triage failures.
///
/// `direction`: 'push' = Rhud → Odoo, 'pull' = Odoo → Rhud.
/// `status`:    'ok' | 'error' | 'skipped'.
model OdooSyncLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  rhudEntity   String?  @map("rhud_entity")
  rhudId       String?  @map("rhud_id")
  odooModel    String?  @map("odoo_model")
  odooId       Int?     @map("odoo_id")
  direction    String
  operation    String   /// 'create' | 'update' | 'unlink' | 'read' | 'webhook'
  status       String
  triggeredBy  String   @map("triggered_by")  /// 'auto' | 'manual' | 'webhook'
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  errorMessage String?  @map("error_message")
  /// Snapshot of the request payload (headers/body) — JSON for human
  /// inspection only; never used for replay.
  requestPayload  Json? @map("request_payload")
  responsePayload Json? @map("response_payload")
  durationMs   Int?     @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("odoo_sync_logs")
}

/// Inbound webhook events from Odoo Studio's Automation Rules. The
/// receiver verifies the shared secret, persists the raw event here,
/// then dispatches it to the right handler. Persistence first (before
/// dispatch) means we can replay if dispatch fails.
model OdooWebhookEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Resource that fired — 'crm.lead' | 'res.partner' | etc.
  odooModel   String   @map("odoo_model")
  /// Odoo record id from the payload.
  odooId      Int?     @map("odoo_id")
  /// 'create' | 'write' | 'unlink' (the verb the automation rule used).
  eventType   String   @map("event_type")
  /// Raw body posted by Odoo. Trustless — only act on it after fetching
  /// the canonical record from Odoo.
  payload     Json
  /// 'pending' | 'processed' | 'failed' | 'ignored'
  status      String   @default("pending")
  errorMessage String? @map("error_message")
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@map("odoo_webhook_events")
}

/// Per-tenant Gamma integration. API key encrypted via the same
/// envelope scheme as TenantLlmConfig (master key in
/// `LLM_KEY_ENCRYPTION_KEY` env). `proposalDriver` lets the tenant
/// choose whether proposal drafts come from the LLM or from Gamma —
/// both write into the same `engagements.proposal_draft` slot, so the
/// downstream UI shape stays unified.
model TenantGammaConfig {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  /// Optional friendly label shown in the UI ("Acme Workspace").
  workspaceName        String?  @map("workspace_name")
  /// Optional Gamma workspace id when the API needs it (Gamma's
  /// docs use this for routing decks to a specific workspace).
  workspaceId          String?  @map("workspace_id")
  apiKeyCiphertext     Bytes?   @map("api_key_ciphertext")
  apiKeyIv             Bytes?   @map("api_key_iv")
  apiKeyDekCiphertext  Bytes?   @map("api_key_dek_ciphertext")
  apiKeyDekIv          Bytes?   @map("api_key_dek_iv")
  /// Which engine drafts proposals for this tenant.
  /// "llm" = use the configured LLM provider (default).
  /// "gamma" = use Gamma's deck generator.
  proposalDriver       String   @default("llm") @map("proposal_driver")
  enabled              Boolean  @default(true)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_gamma_config")
}

// ── Site enumeration: crawl a prospect's existing site → categorised scope ──
//
// Given a URL, the crawler discovers same-origin pages (sitemap-first, BFS
// fallback), classifies each by category (product, blog, form, …), and the
// aggregated counts are mapped to ScopedEntity[] against a rate card so the
// existing pricing engine can produce a base quote without the prospect
// filling out a questionnaire. One-to-one with engagement; the same crawl
// can be re-mapped against multiple rate cards (cached under
// `inferred_entities[rateCardId]`).
//
// Status state machine — mirrors EngagementFile.extraction_status:
//   pending → crawling → classifying → ready
//                                    └─→ failed
//                                    └─→ retry_queued → crawling (cron)
model SiteEnumeration {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  engagementId   String    @unique @map("engagement_id") @db.Uuid
  siteUrl        String    @map("site_url")
  /// pending | crawling | classifying | ready | failed | retry_queued — CHECK in migration.
  status         String    @default("pending")
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  /// Total URLs discovered across crawl + sitemap.
  totalUrls      Int       @default(0) @map("total_urls")
  /// Subset already classified (heuristic or LLM). UI shows X/Y progress.
  classifiedUrls Int       @default(0) @map("classified_urls")
  /// Rate-card-INDEPENDENT category breakdown:
  ///   { [category]: { count, examples: [{url, title}] } }
  /// Persisted on `ready`. UI's primary read.
  categoriesJson   Json?   @map("categories_json")
  /// Per-rate-card mapping snapshot:
  ///   { [rateCardId]: { entities: ScopedEntity[], computedAt: ISO } }
  /// Cached so re-pricing against a different card is instant; the same
  /// pattern as `engagement_files.inferred_entities`.
  inferredEntities Json?   @map("inferred_entities")
  /// Crawl options snapshot — what limits the crawl ran with. Keeps a
  /// re-crawl reproducible without re-deriving from defaults.
  ///   { maxPages, maxDepth, includePathRegex?, excludePathRegex? }
  optionsJson      Json?   @map("options_json")
  /// Retry queue (mirrors engagement_files):
  attempts         Int       @default(0)
  retryAt          DateTime? @map("retry_at") @db.Timestamptz
  error            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt      @map("updated_at") @db.Timestamptz

  engagement Engagement              @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  pages      SiteEnumerationPage[]

  @@index([tenantId])
  @@index([status, retryAt])
  @@map("site_enumerations")
}

model SiteEnumerationPage {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  enumerationId        String    @map("enumeration_id") @db.Uuid
  url                  String
  httpStatus           Int?      @map("http_status")
  contentType          String?   @map("content_type")
  title                String?
  description          String?
  /// Canonical category — see SITE_URL_CATEGORIES in @rhud/shared.
  ///   product | ecommerce | blog | cms | form | knowledge_base | attachment
  ///   | members | media | module | other
  category             String?
  classifierConfidence Float?    @map("classifier_confidence")
  /// 'heuristic' | 'llm' — provenance for the category assignment.
  classifierSource     String?   @map("classifier_source")
  fetchedAt            DateTime  @map("fetched_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  enumeration SiteEnumeration @relation(fields: [enumerationId], references: [id], onDelete: Cascade)

  @@unique([enumerationId, url], map: "site_enumeration_pages_enum_url_uniq")
  @@index([enumerationId, category])
  @@index([tenantId])
  @@map("site_enumeration_pages")
}

// ── Lead-management: tickets, follow-ups, AI summaries ────────────────

/// A ticket raised against an engagement. Covers complaints, change
/// requests, internal check-ins. Status flows open → in_progress →
/// resolved (or wont_fix). Audit-tracked via thread_events
/// (ticket_opened / ticket_status_changed / ticket_resolved).
model EngagementTicket {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  engagementId   String    @map("engagement_id") @db.Uuid
  /// 'complaint' | 'question' | 'change_request' | 'check_in' | 'internal_note'
  category       String
  /// 'low' | 'medium' | 'high' | 'urgent' — CHECK in migration.
  priority       String    @default("medium")
  /// 'open' | 'in_progress' | 'resolved' | 'wont_fix'
  status         String    @default("open")
  title          String
  description    String?
  /// 'client' | 'sales_rep' | 'sales_manager' | 'admin' | 'system'
  raisedBy       String    @map("raised_by")
  raisedByUserId String?   @map("raised_by_user_id") @db.Uuid
  raisedByEmail  String?   @map("raised_by_email")
  assignedTo     String?   @map("assigned_to") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  resolutionNote String?   @map("resolution_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagement     Engagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  followUps      EngagementFollowUp[] @relation("TicketRelatedFollowUps")

  @@index([tenantId])
  @@index([engagementId])
  @@map("engagement_tickets")
}

/// A scheduled follow-up reminder against an engagement. The manager
/// dashboard lists pending ones due in the next N days. Completion is
/// soft (completed_at set) so the row stays for audit.
model EngagementFollowUp {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  engagementId    String    @map("engagement_id") @db.Uuid
  scheduledFor    DateTime  @map("scheduled_for") @db.Timestamptz
  reason          String
  assignedTo      String?   @map("assigned_to") @db.Uuid
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  completedBy     String?   @map("completed_by") @db.Uuid
  completionNote  String?   @map("completion_note")
  /// Optional FK back to a ticket the follow-up was created for or
  /// resolved. Helps the rep see "this follow-up was for the
  /// scope-change ticket" without extra clicks.
  relatedTicketId String?   @map("related_ticket_id") @db.Uuid
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagement   Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  relatedTicket EngagementTicket? @relation("TicketRelatedFollowUps", fields: [relatedTicketId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([engagementId])
  @@map("engagement_follow_ups")
}

/// One row per engagement: the most recent LLM-generated summary.
/// Re-running the summariser overwrites in place. The thread events
/// table is the immutable audit, which is enough provenance for v1.
model EngagementSummary {
  engagementId             String    @id @map("engagement_id") @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  summaryText              String    @map("summary_text")
  /// 'low' | 'medium' | 'high'
  riskLevel                String    @default("low") @map("risk_level")
  /// Array of { title, urgency, owner? }
  nextActions              Json      @default("[]") @map("next_actions")
  recommendedFollowUpDays  Int?      @map("recommended_follow_up_days")
  /// 'llm' | 'manual'
  generatedBy              String    @default("llm") @map("generated_by")
  /// Provider/model id when generated_by='llm', e.g. "anthropic:claude-opus-4-7".
  model                    String?
  inputTokens              Int?      @map("input_tokens")
  outputTokens             Int?      @map("output_tokens")
  generatedByUserId        String?   @map("generated_by_user_id") @db.Uuid
  generatedAt              DateTime  @default(now()) @map("generated_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, riskLevel])
  @@map("engagement_summaries")
}
