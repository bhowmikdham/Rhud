# ── Postgres (matches infra/docker-compose.yml) ───────────────────────────────
# DATABASE_URL is used by Prisma migrations + by the narrow `UnscopedDb`
# whitelist (login lookups). It connects as the `rhud` superuser, which is
# allowed to bypass RLS — necessary so migrations can touch all tables and
# auth-time lookups can find users before a tenant is known.
DATABASE_URL=postgresql://rhud:rhud@localhost:5432/rhud?schema=public

# APP_DATABASE_URL is used by the runtime API. It connects as `rhud_app`,
# explicitly NOBYPASSRLS — meaning every query MUST happen inside a
# `withTenant()` scope (which sets app.tenant_id), or it returns no rows.
# This is the connection that enforces tenant isolation at the DB level.
APP_DATABASE_URL=postgresql://rhud_app:rhud_app@localhost:5432/rhud?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3-compatible object storage (MinIO locally) ──────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rhud
S3_SECRET_KEY=rhud-secret
S3_BUCKET=rhud-dev

# ── Auth ──────────────────────────────────────────────────────────────────────
# 256-bit (32-byte) random. Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-real-secret
JWT_EXPIRES_IN=24h
MAGIC_LINK_TTL_MINUTES=15

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
API_CORS_ORIGIN=http://localhost:3000

# ── ML service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001
