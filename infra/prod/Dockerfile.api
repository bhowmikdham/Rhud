# syntax=docker/dockerfile:1.7
#
# NestJS API image for the Rhud monorepo.
# Build context = repo root (see infra/prod/docker-compose.yml).
#
# Layers:
#   base      → node + system libs + pnpm
#   build     → install all deps, generate Prisma client, compile Nest
#   runtime   → minimal image with prod-only deps, non-root user

ARG NODE_IMAGE=node:22-bookworm-slim
ARG PNPM_VERSION=9.12.0

# ────────────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# js-crawler.service.ts lazy-loads playwright and explicitly handles the
# "playwright_not_installed" path, so we skip downloading chromium.
# Saves ~400 MB image weight + several minutes of build time.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# ────────────────────────────────────────────────────────────────────
FROM base AS build
WORKDIR /app

# Copy workspace manifests first so this layer is cached when only sources change.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/

# Install all deps (dev + prod). BuildKit cache mount keeps the pnpm
# store across builds without bloating image layers.
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy sources we actually need to build the api.
COPY packages/shared packages/shared
COPY apps/api apps/api

# Compile @rhud/shared first — both api and web import from its `dist/`
# (see packages/shared/package.json "main" and "exports"). Without this
# step the api build can resolve the package name via pnpm workspace
# linking but the type-check / runtime import fails because dist/ is empty.
RUN pnpm --filter @rhud/shared build

# Generate the Prisma client (writes to node_modules/.prisma/client + @prisma/client).
RUN pnpm --filter @rhud/api exec prisma generate

# Compile NestJS → apps/api/dist.
RUN pnpm --filter @rhud/api build

# ────────────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r app && useradd -r -g app -m -d /home/app app

WORKDIR /app

# Bring the workspace skeleton across. We copy the full build node_modules
# (including dev deps) rather than going through `pnpm deploy --prod`,
# which in pnpm 9 was producing flaky bin symlinks and dropping the
# generated Prisma client. The image is ~200 MB larger but the build
# is reliable and easier to reason about. For a single-node demo deploy
# that trade is worth it.
COPY --from=build --chown=app:app /app/node_modules                   ./node_modules
COPY --from=build --chown=app:app /app/package.json                   ./package.json
COPY --from=build --chown=app:app /app/pnpm-workspace.yaml            ./pnpm-workspace.yaml
COPY --from=build --chown=app:app /app/packages/shared/package.json   ./packages/shared/package.json
COPY --from=build --chown=app:app /app/packages/shared/dist           ./packages/shared/dist
COPY --from=build --chown=app:app /app/packages/shared/node_modules   ./packages/shared/node_modules
COPY --from=build --chown=app:app /app/apps/api/package.json          ./apps/api/package.json
COPY --from=build --chown=app:app /app/apps/api/dist                  ./apps/api/dist
COPY --from=build --chown=app:app /app/apps/api/prisma                ./apps/api/prisma
COPY --from=build --chown=app:app /app/apps/api/node_modules          ./apps/api/node_modules

WORKDIR /app/apps/api
USER app
ENV NODE_ENV=production
EXPOSE 8000

# tini reaps zombies and forwards signals so SIGTERM from `docker stop`
# reaches Node directly instead of being swallowed by PID 1.
ENTRYPOINT ["tini", "--"]
CMD ["node", "dist/main.js"]
