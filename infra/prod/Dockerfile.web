# syntax=docker/dockerfile:1.7
#
# Next.js web image for the Rhud monorepo.
# Build context = repo root.
# Relies on `output: 'standalone'` in apps/web/next.config.mjs to produce
# a minimal self-contained server bundle (no need for pnpm or node_modules
# in the runtime image — Next traces the exact set of files needed).

ARG NODE_IMAGE=node:22-bookworm-slim
ARG PNPM_VERSION=9.12.0

# ────────────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
ENV NEXT_TELEMETRY_DISABLED=1

# ────────────────────────────────────────────────────────────────────
FROM base AS build
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY apps/web apps/web

RUN pnpm --filter @rhud/web build

# ────────────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r app && useradd -r -g app -m -d /home/app app

WORKDIR /app

# Next standalone preserves the monorepo layout under .next/standalone/.
# The runnable server.js ends up at /app/apps/web/server.js.
COPY --from=build --chown=app:app /app/apps/web/.next/standalone /app
COPY --from=build --chown=app:app /app/apps/web/.next/static     /app/apps/web/.next/static

USER app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app/apps/web
EXPOSE 3000

ENTRYPOINT ["tini", "--"]
CMD ["node", "server.js"]
